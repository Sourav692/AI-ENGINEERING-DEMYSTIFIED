# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# NOTE: content/ is deliberately NOT ignored. It is generated by
# scripts/sync-content.mjs from 14_Interview_Preparation/FDE/, which lives outside
# this directory and so is invisible to a deploy rooted at site/. Committing the
# snapshot lets the build work from either the sources or the checked-in copy.
# Never edit it by hand — run `npm run sync` and commit the result.
